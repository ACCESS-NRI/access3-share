spack:
  include:
  # Include configuration from this repository, with the environment variable defined in build-ci
  - path: $SPACK_MANIFEST_REPOSITORY_PATH/.github/build-ci/config
  specs:
  - access3 @git.{{ ref }}=stable configurations=MOM6,CICE6,WW3,MOM6-WW3,MOM6-CICE6,CICE6-WW3,MOM6-CICE6-WW3 %%access_gcc
  packages:
    access3-share:
      require:
        '@git.{{ ref }}=stable'
  view: false
